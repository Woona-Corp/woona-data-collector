    <string name="transport_profile_conservative_short">High priority only, no MTU request, no PHY override.</string>
    <string name="transport_profile_conservative_detail_1">Requests HIGH connection priority only.</string>
    <string name="transport_profile_conservative_detail_2">Skips explicit MTU negotiation and uses the stack/device default.</string>
    <string name="transport_profile_conservative_detail_3">Skips preferred PHY request and keeps the system default link mode.</string>

