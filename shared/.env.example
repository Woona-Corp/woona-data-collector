POSTGRES_DB=woona
POSTGRES_USER=woona
POSTGRES_PASSWORD=woona-local-only
WOONA_DEVICE_ID=00000000-0000-0000-0000-000000000001
WOONA_DEVICE_LABEL=Local device
WOONA_DEBUG_TOKEN=change-me-local-token
WOONA_ALLOW_LEGACY_MIGRATION=true
WOONA_API_PORT=8080
WOONA_STORAGE_ROOT_HOST=../var/storage
# Set an absolute path to keep PostgreSQL in a local folder instead of a Docker volume.
# WOONA_POSTGRES_ROOT=/absolute/path/to/var/postgres

# Quotas charge declared artifact bytes, including accepted pending uploads.
# Zero explicitly disables that logical quota; physical-space checks still apply.
WOONA_RECORDING_QUOTA_BYTES=21474836480
WOONA_ACCOUNT_QUOTA_BYTES=107374182400
WOONA_UPLOAD_FREE_SPACE_RESERVE_BYTES=268435456
# HTTP checksum audits remain bounded even when these caps are increased.
WOONA_INTEGRITY_MAX_ARTIFACTS=50
WOONA_INTEGRITY_MAX_FILE_BYTES=16777216
WOONA_INTEGRITY_MAX_HASH_BYTES=33554432
WOONA_INTEGRITY_MAX_SECONDS=2
WOONA_INTEGRITY_MIN_INTERVAL_SECONDS=1
